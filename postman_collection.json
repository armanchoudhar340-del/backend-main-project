{
  "info": {
    "name": "Parking Slot Management System API",
    "_postman_id": "parking-slot-management-id",
    "description": "REST API Collection for B.Tech Project - Parking Slot Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "http://localhost:5001/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:5001/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:5001/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": { "raw": "http://localhost:5001/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Parking Slots",
      "item": [
        {
          "name": "Get All Slots",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5001/api/slots", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "slots"] }
          }
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5001/api/slots/available", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "slots", "available"] }
          }
        },
        {
          "name": "Create Slot (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotNumber\": \"C-05\",\n  \"location\": \"Basement 2 - VIP\",\n  \"status\": \"available\"\n}"
            },
            "url": { "raw": "http://localhost:5001/api/slots", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "slots"] }
          }
        },
        {
          "name": "Occupancy Stats (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "http://localhost:5001/api/slots/occupancy", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "slots", "occupancy"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parkingSlot\": \"{{SLOT_ID}}\",\n  \"startTime\": \"2026-10-10T10:00:00.000Z\",\n  \"endTime\": \"2026-10-10T12:00:00.000Z\",\n  \"vehicleNumber\": \"KA-01-AB-1234\"\n}"
            },
            "url": { "raw": "http://localhost:5001/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": { "raw": "http://localhost:5001/api/bookings/my", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "bookings", "my"] }
          }
        },
        {
          "name": "Get All Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "http://localhost:5001/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5001", "path": ["api", "bookings"] }
          }
        }
      ]
    }
  ]
}
